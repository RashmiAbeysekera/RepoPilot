# ==============================================================================
# RepoPilot AI Backend — Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development: cp .env.example .env
# 2. In production (e.g. Render, Railway), set these variables in the dashboard.
# 3. NEVER commit the real .env file or real secrets to source control.
# ==============================================================================

# Supabase PostgreSQL connection string (Transaction pooler or Session connection).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Comma-separated list of frontend origins allowed to call this API via CORS.
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app,https://your-app-preview.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Server listening port (Render and other cloud platforms provide this automatically).
# Default: 8000
PORT=8000

# Google Gemini API configuration for RAG answer generation and agent reasoning.
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Maximum retries for transient Gemini API errors (e.g. 503 UNAVAILABLE, temporary 429).
GEMINI_MAX_RETRIES=3

# Secret token used to verify GitHub webhook HMAC-SHA256 signatures (optional in dev, recommended in prod).
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Minimum cosine similarity score [0.0, 1.0] for retrieved chunks to be passed to Gemini.
# Chunks below this threshold are filtered out to prevent hallucination.
RAG_SIMILARITY_THRESHOLD=0.20

# Maximum tool-calling loop iterations for the read-only agent investigation workflow.
MAX_AGENT_ITERATIONS=5

# Rate limiting for expensive AI endpoints (process-local sliding window).
RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=15
