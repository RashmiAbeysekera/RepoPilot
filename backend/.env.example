# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

# Supabase PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Origin allowed to call this API in local development.
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API configuration for RAG answer generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Secret used to verify GitHub webhook payloads.
GITHUB_WEBHOOK_SECRET=

# Minimum cosine similarity score [0.0, 1.0] for retrieved chunks to be passed to Gemini.
# Chunks below this threshold are filtered out to prevent hallucination.
RAG_SIMILARITY_THRESHOLD=0.20

# Maximum tool-calling loop iterations for the agentic investigation workflow.
MAX_AGENT_ITERATIONS=5

# Maximum retries for transient Gemini API errors (503 UNAVAILABLE, 429 backoff).
GEMINI_MAX_RETRIES=3

# Rate limiting for expensive AI endpoints (process-local sliding window).
RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=15



