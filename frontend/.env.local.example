# ==============================================================================
# RepoPilot AI Frontend — Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. For local development: copy this file to .env.local: cp .env.local.example .env.local
# 2. For production (e.g. Vercel): set NEXT_PUBLIC_API_URL in Project Settings -> Environment Variables.
# 3. Security Warning: NEVER put private API keys (Gemini, Supabase service-role, GitHub tokens)
#    into frontend environment variables. Only public/client-safe variables with
#    NEXT_PUBLIC_ prefix should be configured here.
# ==============================================================================

# Backend API base URL
# Local dev: http://localhost:8000
# Production: https://your-backend-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
